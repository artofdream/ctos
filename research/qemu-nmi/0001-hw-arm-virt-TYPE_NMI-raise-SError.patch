From: ctos research <noreply@ctos.local>
Subject: [PATCH] hw/arm/virt: TYPE_NMI raises physical async SError (ctos pin)

ctos ADR-083 / B1 pin against QEMU v10.0.0 (7c949c53e936aa3a658d84ab53bae5cadaa5d59c).

Upstream virt lacks TYPE_NMI, so QMP inject-nmi returns "machine does not
provide NMIs". FEAT_NMI is an architectural interrupt NMI, not async SError.

This patch:
  - adds EXCP_SERROR / CPU_INTERRUPT_SERROR (TCG physical async SError)
  - takes it when PSTATE.A is clear (arm_excp_unmasked)
  - registers TYPE_NMI on virt so inject-nmi raises CPU_INTERRUPT_SERROR

Not FIQ/BRK/FEAT_NMI-as-SError. Apply only via scripts/build-qemu-nmi.sh.

diff --git a/hw/arm/virt.c b/hw/arm/virt.c
index a96452f..0826864 100644
--- a/hw/arm/virt.c
+++ b/hw/arm/virt.c
@@ -66,6 +66,8 @@
 #include "hw/intc/arm_gicv3_common.h"
 #include "hw/intc/arm_gicv3_its_common.h"
 #include "hw/irq.h"
+#include "hw/nmi.h"
+#include "hw/core/cpu.h"
 #include "kvm_arm.h"
 #include "hvf_arm.h"
 #include "hw/firmware/smbios.h"
@@ -3124,10 +3126,26 @@ static int virt_hvf_get_physical_address_range(MachineState *ms)
     return requested_ipa_size;
 }
 
+/* ctos pin (ADR-083): QMP inject-nmi raises physical async SError on CPU0.
+ * Not FEAT_NMI. Not FIQ/BRK. TCG-only smoke path.
+ */
+static void virt_nmi(NMIState *n, int cpu_index, Error **errp)
+{
+    CPUState *cs;
+
+    cs = qemu_get_cpu(cpu_index < 0 ? 0 : cpu_index);
+    if (!cs) {
+        error_setg(errp, "invalid CPU index %d for NMI", cpu_index);
+        return;
+    }
+    cpu_interrupt(cs, CPU_INTERRUPT_SERROR);
+}
+
 static void virt_machine_class_init(ObjectClass *oc, void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
     HotplugHandlerClass *hc = HOTPLUG_HANDLER_CLASS(oc);
+    NMIClass *nc = NMI_CLASS(oc);
     static const char * const valid_cpu_types[] = {
 #ifdef CONFIG_TCG
         ARM_CPU_TYPE_NAME("cortex-a7"),
@@ -3199,6 +3217,7 @@ static void virt_machine_class_init(ObjectClass *oc, void *data)
     mc->cpu_cluster_has_numa_boundary = true;
     mc->default_ram_id = "mach-virt.ram";
     mc->default_nic = "virtio-net-pci";
+    nc->nmi_monitor_handler = virt_nmi;
 
     object_class_property_add(oc, "acpi", "OnOffAuto",
         virt_get_acpi, virt_set_acpi,
@@ -3398,6 +3417,7 @@ static const TypeInfo virt_machine_info = {
     .instance_init = virt_instance_init,
     .interfaces = (InterfaceInfo[]) {
          { TYPE_HOTPLUG_HANDLER },
+         { TYPE_NMI },
          { }
     },
 };
diff --git a/target/arm/cpu.c b/target/arm/cpu.c
index 01786ac..a519ed2 100644
--- a/target/arm/cpu.c
+++ b/target/arm/cpu.c
@@ -140,6 +140,7 @@ static bool arm_cpu_has_work(CPUState *cs)
         (CPU_INTERRUPT_FIQ | CPU_INTERRUPT_HARD
          | CPU_INTERRUPT_NMI | CPU_INTERRUPT_VINMI | CPU_INTERRUPT_VFNMI
          | CPU_INTERRUPT_VFIQ | CPU_INTERRUPT_VIRQ | CPU_INTERRUPT_VSERR
+         | CPU_INTERRUPT_SERROR
          | CPU_INTERRUPT_EXITTB);
 }
 #endif /* !CONFIG_USER_ONLY */
@@ -743,6 +744,10 @@ static inline bool arm_excp_unmasked(CPUState *cs, unsigned int excp_idx,
             return false;
         }
         return !(env->daif & PSTATE_A);
+    case EXCP_SERROR:
+        /* Physical async SError: maskable by PSTATE.A only. */
+        pstate_unmasked = !(env->daif & PSTATE_A);
+        break;
     default:
         g_assert_not_reached();
     }
@@ -883,6 +888,16 @@ static bool arm_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
         }
     }
 
+    if (interrupt_request & CPU_INTERRUPT_SERROR) {
+        excp_idx = EXCP_SERROR;
+        target_el = arm_phys_excp_target_el(cs, excp_idx, cur_el, secure);
+        if (arm_excp_unmasked(cs, excp_idx, target_el,
+                              cur_el, secure, hcr_el2)) {
+            /* One-shot monitor inject (ctos TYPE_NMI pin). */
+            cpu_reset_interrupt(cs, CPU_INTERRUPT_SERROR);
+            goto found;
+        }
+    }
     if (interrupt_request & CPU_INTERRUPT_FIQ) {
         excp_idx = EXCP_FIQ;
         target_el = arm_phys_excp_target_el(cs, excp_idx, cur_el, secure);
diff --git a/target/arm/cpu.h b/target/arm/cpu.h
index a8177c6..9461afc 100644
--- a/target/arm/cpu.h
+++ b/target/arm/cpu.h
@@ -63,6 +63,7 @@
 #define EXCP_VINMI          27
 #define EXCP_VFNMI          28
 #define EXCP_MON_TRAP       29   /* AArch32 trap to Monitor mode */
+#define EXCP_SERROR         30   /* Physical async SError (ctos pin) */
 /* NB: add new EXCP_ defines to the array in arm_log_exception() too */
 
 #define ARMV7M_EXCP_RESET   1
@@ -85,6 +86,7 @@
 #define CPU_INTERRUPT_NMI   CPU_INTERRUPT_TGT_EXT_4
 #define CPU_INTERRUPT_VINMI CPU_INTERRUPT_TGT_EXT_0
 #define CPU_INTERRUPT_VFNMI CPU_INTERRUPT_TGT_INT_1
+#define CPU_INTERRUPT_SERROR CPU_INTERRUPT_TGT_INT_2 /* physical async SError */
 
 /* The usual mapping for an AArch64 system register to its AArch32
  * counterpart is for the 32 bit world to have access to the lower
diff --git a/target/arm/helper.c b/target/arm/helper.c
index bb445e3..a073fa0 100644
--- a/target/arm/helper.c
+++ b/target/arm/helper.c
@@ -9906,6 +9906,7 @@ void arm_log_exception(CPUState *cs)
             [EXCP_VINMI] = "Virtual IRQ NMI",
             [EXCP_VFNMI] = "Virtual FIQ NMI",
             [EXCP_MON_TRAP] = "Monitor Trap",
+            [EXCP_SERROR] = "SError",
         };
 
         if (idx >= 0 && idx < ARRAY_SIZE(excnames)) {
@@ -10466,6 +10467,23 @@ static void arm_cpu_do_interrupt_aarch32(CPUState *cs)
             offset = 8;
         }
         break;
+    case EXCP_SERROR:
+        {
+            /* Physical async SError taken as data abort in AArch32. */
+            ARMMMUFaultInfo fi = { .type = ARMFault_AsyncExternal, };
+
+            if (extended_addresses_enabled(env)) {
+                env->exception.fsr = arm_fi_to_lfsc(&fi);
+            } else {
+                env->exception.fsr = arm_fi_to_sfsc(&fi);
+            }
+            A32_BANKED_CURRENT_REG_SET(env, dfsr, env->exception.fsr);
+            new_mode = ARM_CPU_MODE_ABT;
+            addr = 0x10;
+            mask = CPSR_A | CPSR_I;
+            offset = 8;
+        }
+        break;
     case EXCP_SMC:
         new_mode = ARM_CPU_MODE_MON;
         addr = 0x08;
@@ -10746,6 +10764,12 @@ static void arm_cpu_do_interrupt_aarch64(CPUState *cs)
         env->exception.syndrome = syn_serror(env->cp15.vsesr_el2 & 0x1ffffff);
         env->cp15.esr_el[new_el] = env->exception.syndrome;
         break;
+    case EXCP_SERROR:
+        addr += 0x180;
+        /* Physical async SError (monitor inject / ctos TYPE_NMI pin). */
+        env->exception.syndrome = syn_serror(0);
+        env->cp15.esr_el[new_el] = env->exception.syndrome;
+        break;
     default:
         cpu_abort(cs, "Unhandled exception 0x%x\n", cs->exception_index);
     }
