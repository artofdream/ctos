# Windows `core.autocrlf` must not rewrite shebangs to CRLF.
# the arm64 workstation 2026-09-09: `docker run` failed with
# `exec ./scripts/qemu-smoke.sh: no such file or directory`.
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
# ADR-114 R1 golden files are byte-exact (CR / NUL / non-ASCII on purpose).
tests/fixtures/adr114/* -text
